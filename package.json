{
  "name": "tests-diet",
  "version": "0.2.1",
  "description": "Find the tests that are not worth their CI cost, with a pool of pi agents",
  "keywords": [
    "tests",
    "pruning",
    "agents",
    "pi",
    "ci"
  ],
  "homepage": "https://github.com/arthurfiorette/tests-diet#readme",
  "bugs": {
    "url": "https://github.com/arthurfiorette/tests-diet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurfiorette/tests-diet.git"
  },
  "funding": "https://github.com/arthurfiorette/tests-diet?sponsor=1",
  "license": "MIT",
  "author": "Arthur Fiorette <me@arthur.place>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tests-diet": "./bin/tests-diet.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "generate": "tsx scripts/generate-schema.ts && biome format --write schema.json",
    "lint": "biome check .",
    "lint-ci": "biome ci .",
    "lint-fix": "biome check --write --unsafe .",
    "prepack": "pnpm generate && pnpm build",
    "test": "tsx --test test/*.test.ts",
    "test-types": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@kitajs/html": "^4.2.13",
    "ignore": "^7.0.14",
    "picomatch": "^4.0.7",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@arthurfiorette/biomejs-config": "^2.0.1",
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.16"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24.16"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
